    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@tanstack/react-query": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "@workspace/notifications": "workspace:*",
    "expo": "~55.0.26",
    "expo-application": "~55.0.15",
    "expo-auth-session": "~55.0.16",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-file-system": "~55.0.8",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.16",
    "firebase": "^12.13.0",
    "onesignal-expo-plugin": "^2.6.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-onesignal": "^5.4.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "postinstall": "node ./scripts/ensure-local-node-modules.js",
    "dev:kill-ports": "node ./scripts/kill-dev-ports.js",
    "dev:link-modules": "node ./scripts/ensure-local-node-modules.js",
    "start": "node ./scripts/kill-dev-ports.js && node ./scripts/ensure-local-node-modules.js && expo start --dev-client --port 8081 -c",
    "android": "node ./scripts/kill-dev-ports.js && expo run:android --port 8081",
    "ios": "node ./scripts/run-ios-safe.js",
    "ios:safe": "node ./scripts/run-ios-safe.js",
    "ios:clean": "bash ./scripts/rebuild-ios-clean.sh",
    "ios:open": "node ./scripts/open-ios-dev.js",
    "web": "expo start --web --port 8081",
    "eas:env:push": "eas env:push --environment production --path .env",
    "eas:update": "eas update --channel production --environment production --message",
    "eas-build-pre-install": "node ./scripts/check-eas-env.js"
  },
  "private": true
}
