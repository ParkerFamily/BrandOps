#############################################
# BrandOps Mobile (Expo) Environment Variables
# - Copy to `.env` (do not commit)
# - Expo only exposes vars prefixed with EXPO_PUBLIC_
#############################################

# ========= Firebase (BrandOps Mobile iOS — GoogleService-Info.plist) =========
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCeaxsySmlI5cCJiMClbXsvd9eIl6WCvCU
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=rareswap-ec574.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=rareswap-ec574
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=rareswap-ec574.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1041255855912
EXPO_PUBLIC_FIREBASE_APP_ID=1:1041255855912:ios:d965e83dfb6e7d5bc0021d
# Android (register app in Firebase with package com.parkerfamily.brandopsmobile):
# EXPO_PUBLIC_FIREBASE_APP_ID=1:1041255855912:android:xxxxxxxx
# Optional: download google-services.json into artifacts/brandops-mobile/ (app.config.js picks it up automatically)

# ========= API (BrandOps backend) =========
# Production: https://brandopsapp.com/api — Local: http://127.0.0.1:8080
EXPO_PUBLIC_API_BASE_URL=https://brandopsapp.com/api

# ========= Web app (BrandOps dashboard in browser) =========
EXPO_PUBLIC_WEB_APP_URL=https://brandopsapp.com

# ========= Google Sign-In (Firebase Auth) =========
# Web app client ID (required on iOS + Android) + iOS OAuth client (bundle must match app.json ios.bundleIdentifier)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1041255855912-5ttvd5natbopeb8l6gjbjltdk88boq9n.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1041255855912-217e2nng1u98jghmeqfrst7n5hbruavf.apps.googleusercontent.com
# Android: add SHA-1 from EAS credentials to Firebase Android app; web client ID above is enough for sign-in.
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com

# ========= Sign in with Apple (Firebase Auth) =========
# Enable Apple provider in Firebase Console → Authentication → Sign-in method.
# Apple Developer → Identifiers → com.parkerfamily.brandops-mobile → enable Sign In with Apple.
# Requires a new native iOS build (EAS) — OTA updates alone cannot add the entitlement.

# ========= Stripe =========
# Publishable key only (never secret key)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51TbtrZBUl8zlcM3kUHZ8MYscwe0FFEEapI5bKiujcghpwMIhcKwN3g7Iz1PiEUha1Bw9AMQYIc4zm0H4c8WLbrzV00tddBRubq

# ========= OneSignal (push notifications) =========
# Dashboard → Settings → Keys & IDs → OneSignal App ID
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# If you have a server route that proxies OpenAI safely:
# Example: https://api.brandops.com/api/openai
EXPO_PUBLIC_OPENAI_ROUTE_BASE_URL=http://localhost:1106/modelfarm/openai

